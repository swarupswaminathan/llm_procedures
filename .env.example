# Copy to .env and fill in values. Never commit real keys or endpoints.

# --- API keys ---
AZURE_API_KEY=
QWEN_API_KEY=

# --- Endpoints (required; set in your private .env only) ---
AZURE_OPENAI_ENDPOINT=
AZURE_ANTHROPIC_ENDPOINT=
AZURE_COMPAT_ENDPOINT=
QWEN_ENDPOINT=

# --- Non-secret API settings ---
API_VERSION=2025-03-01-preview

# --- Data / output paths (optional; defaults point at repo data/ and results/) ---
# DATA_XLSX=data/test_adjudicated_procedures.xlsx
# RESULTS_ROOT=results
